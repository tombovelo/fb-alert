# ---------------------------------------------------------------
# FB-Alert Tracker — variables d'environnement (backend NestJS)
# Copier vers .env puis remplir. Aucun secret ne doit être committé.
# ---------------------------------------------------------------

# --- Base de données (PostgreSQL) ---
DATABASE_URL="postgresql://fbalert:MOT_DE_PASSE@localhost:5432/fb_summarizer?schema=public"

# --- Serveur ---
PORT=4100
# "*"" ou liste d'origines séparées par des virgules (app mobile / web) — voir ci-dessous
# exemples : *   |   http://192.168.1.176:8081,http://localhost:8081
CORS_ORIGIN="*"

# --- Redis / BullMQ (file de scraping) ---
REDIS_URL="redis://localhost:6379"

# --- IA (Module 3) : OpenRouter en priorité, Gemini en secours ---
OPENROUTER_API_KEY=""
OPENROUTER_MODELS="qwen/qwen3.8-27b:free,nvidia/nemotron-3-super-120b-a12b:free"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
# "true" = simulation sans appel IA (tests)
AI_MOCK=false
GEMINI_MOCK=false

# --- Playwright (Module 1 - scraper) ---
FB_HEADLESS=true
FB_STORAGE_STATE="./fb-storage-state.json"
FB_NAV_TIMEOUT_MS=45000
FB_AUTO_SCROLL_STEPS=2
FB_POSTS_LIMIT=10
FB_COLLECT_MS=70000
FB_GRAPHQL_WAIT_MS=45000
FB_MKT_DETAIL_MAX=10

# --- Queue (Module 2) ---
FB_QUEUE_CONCURRENCY=1
QUEUE_SCHEDULER_ENABLED=true

# --- Divers ---
REDIS_SEEN_TTL_DAYS=30

# --- Rétention des publications ---
# Nettoyage automatique chaque nuit à 1 h : publications et notifications
# plus vieilles que POST_RETENTION_DAYS jours sont supprimées.
POST_RETENTION_DAYS=30
RETENTION_ENABLED=true
